# Staging. Читается и vite (APP_ENV=stg), и entrypoint контейнера.
# Формат: KEY=value, без кавычек. Любой ключ переопределяется
# одноимённой переменной окружения (в контейнере — приоритет у ENV).
#
# СЕКРЕТОВ ЗДЕСЬ БЫТЬ НЕ МОЖЕТ. Всё отсюда уезжает в браузер в /config.js
# и видно любому через view-source — потому файл и лежит в git.
# Нужно что-то тайное — это в бэкенд (Infisical), а не сюда.

# Куда nginx/vite проксируют /api. Сам сайт живёт на stg.onemore.styleu.ru,
# API — отдельный хост stg.onemoreadmin.styleu.ru (сервис onemore-admin).
API_UPSTREAM=https://stg.onemoreadmin.styleu.ru

# Logto API resource (audience access-токенов). Это ИДЕНТИФИКАТОР ресурса,
# а не адрес: совпадает с logto.apiResource в config_staging.yaml бэкенда
# и намеренно не равен API_UPSTREAM.
API_RESOURCE=https://stg.onemore.styleu.ru

LOGTO_ENDPOINT=https://lg1l5k.logto.app
# SPA-приложение Logto «stg». Redirect URI: https://stg.onemore.styleu.ru/callback
LOGTO_APP_ID=tselpitobz6t76ioniof2

AUTH_MODE=logto

# Отдавать ли из памяти ручки, которых на бэкенде ещё нет
# (список — MOCKED_PREFIXES в shared/api/mock-handlers.ts).
# На стенде и проде строго false: иначе пользователь увидит выдуманные данные.
MOCK_UNIMPLEMENTED=true

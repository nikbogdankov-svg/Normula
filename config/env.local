# Локальная разработка (APP_ENV по умолчанию).
#
# Осознанно повторяет env.stg: `npm run dev` ходит на тот же стенд и в тот же
# Logto-ресурс, что и staging — локальный фронт и стенд ведут себя одинаково.
# Хочешь локальный бэк — `npm run dev:api-local` (или API_UPSTREAM=... npm run dev).
# Хочешь работать вообще без сети — `npm run dev:mock`.
#
# СЕКРЕТОВ ЗДЕСЬ БЫТЬ НЕ МОЖЕТ. Всё отсюда уезжает в браузер в /config.js
# и видно любому через view-source — потому файл и лежит в git.
# Личные настройки не коммить сюда, а передавать переменной окружения:
# API_UPSTREAM=http://localhost:8080 npm run dev

# API-хост стенда; API_RESOURCE — идентификатор ресурса в Logto, не адрес.
API_UPSTREAM=https://stg.onemoreadmin.styleu.ru
API_RESOURCE=https://stg.onemore.styleu.ru

LOGTO_ENDPOINT=https://lg1l5k.logto.app
# SPA-приложение Logto «dev». Redirect URI: http://localhost:5173/callback
LOGTO_APP_ID=8qpbyla9zbnku0k7od3ct

AUTH_MODE=logto

# Прод. Читается и vite (APP_ENV=prod), и entrypoint контейнера.
# Формат: KEY=value, без кавычек. Любой ключ переопределяется
# одноимённой переменной окружения (в контейнере — приоритет у ENV).
#
# СЕКРЕТОВ ЗДЕСЬ БЫТЬ НЕ МОЖЕТ. Всё отсюда уезжает в браузер в /config.js
# и видно любому через view-source — потому файл и лежит в git.
# Нужно что-то тайное — это в бэкенд (Infisical), а не сюда.

# Куда nginx/vite проксируют /api. Сам сайт живёт на onemore.styleu.ru,
# API — отдельный хост onemoreadmin.styleu.ru (сервис onemore-admin).
API_UPSTREAM=https://onemoreadmin.styleu.ru

# Logto API resource (audience access-токенов). Это ИДЕНТИФИКАТОР ресурса,
# а не адрес: совпадает с logto.apiResource в config_prod.yaml бэкенда
# и намеренно не равен API_UPSTREAM.
API_RESOURCE=https://onemore.styleu.ru

LOGTO_ENDPOINT=https://lg1l5k.logto.app
# SPA-приложение Logto «prod». Redirect URI: https://onemore.styleu.ru/callback
LOGTO_APP_ID=7r6wufui95brwrapxojar

AUTH_MODE=logto
